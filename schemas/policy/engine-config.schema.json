{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/warm-path-audit/schemas/policy/engine-config.schema.json",
  "title": "Deterministic coverage engine configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "configId",
    "version",
    "directContributorIds",
    "icpRuleSet",
    "stakeholderPersonaRuleSet",
    "targetAccounts",
    "accountProfiles",
    "approvedOrganizationAliases",
    "scoring",
    "freshness",
    "suppressions",
    "exclusions",
    "reviewPolicy"
  ],
  "properties": {
    "workspaceId": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "configId": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "directContributorIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/id"
      }
    },
    "icpRuleSet": {
      "$ref": "#/$defs/ruleSet"
    },
    "stakeholderPersonaRuleSet": {
      "$ref": "#/$defs/ruleSet"
    },
    "coachCandidateRuleSet": {
      "$ref": "#/$defs/ruleSet"
    },
    "targetAccounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/account"
      }
    },
    "accountProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organizationId", "attributes"],
        "properties": {
          "organizationId": {
            "$ref": "../common.schema.json#/$defs/id"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/attribute"
            }
          }
        }
      }
    },
    "approvedOrganizationAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aliasId",
          "organizationAliasCandidateId",
          "organizationId",
          "sourceOrganizationId",
          "kind",
          "value",
          "approvedReviewDecisionId"
        ],
        "properties": {
          "aliasId": {
            "$ref": "../common.schema.json#/$defs/id"
          },
          "organizationId": {
            "$ref": "../common.schema.json#/$defs/id"
          },
          "sourceOrganizationId": {
            "$ref": "../common.schema.json#/$defs/id"
          },
          "kind": {
            "enum": ["name", "domain", "crm_id"]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "approvedReviewDecisionId": {
            "$ref": "../common.schema.json#/$defs/id"
          },
          "organizationAliasCandidateId": {
            "$ref": "../common.schema.json#/$defs/id"
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weights", "personaMatchedThreshold", "uncertainLowerBound"],
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accountFit",
            "personaFit",
            "relationshipConfidence",
            "employmentConfidence",
            "pathConfidence",
            "freshness"
          ],
          "properties": {
            "accountFit": {
              "$ref": "#/$defs/weight"
            },
            "personaFit": {
              "$ref": "#/$defs/weight"
            },
            "relationshipConfidence": {
              "$ref": "#/$defs/weight"
            },
            "employmentConfidence": {
              "$ref": "#/$defs/weight"
            },
            "pathConfidence": {
              "$ref": "#/$defs/weight"
            },
            "freshness": {
              "$ref": "#/$defs/weight"
            }
          }
        },
        "personaMatchedThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "uncertainLowerBound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentEmploymentMaxDays",
        "reviewEmploymentMaxDays",
        "relationshipMaxDays"
      ],
      "properties": {
        "currentEmploymentMaxDays": {
          "const": 365
        },
        "reviewEmploymentMaxDays": {
          "const": 730
        },
        "relationshipMaxDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 730
        }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suppression"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value", "reasonCode"],
        "properties": {
          "kind": {
            "$ref": "#/$defs/suppressionKind"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "reasonCode": {
            "$ref": "#/$defs/reasonCode"
          }
        }
      }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uncertainPersona",
        "staleEmployment",
        "unresolvedIdentity",
        "unresolvedOrganization",
        "bAndDRequireReview",
        "reviewReasonCode"
      ],
      "properties": {
        "uncertainPersona": {
          "const": "review_only_candidate"
        },
        "staleEmployment": {
          "enum": ["block", "review_only"]
        },
        "unresolvedIdentity": {
          "const": "block"
        },
        "unresolvedOrganization": {
          "const": "block"
        },
        "bAndDRequireReview": {
          "const": true
        },
        "reviewReasonCode": {
          "$ref": "#/$defs/reasonCode"
        }
      }
    }
  },
  "$defs": {
    "weight": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "attribute": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "ruleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleSetId", "version", "mode", "rules"],
      "properties": {
        "ruleSetId": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "mode": {
          "enum": ["all", "any"]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ruleId", "field", "operator"],
            "properties": {
              "ruleId": {
                "$ref": "../common.schema.json#/$defs/id"
              },
              "field": {
                "enum": [
                  "canonical_name",
                  "domain",
                  "industry",
                  "geography",
                  "employee_count",
                  "stage",
                  "technology",
                  "title",
                  "function",
                  "seniority",
                  "crm_state"
                ]
              },
              "operator": {
                "enum": [
                  "equals",
                  "in",
                  "not_in",
                  "contains_token",
                  "range",
                  "exists"
                ]
              },
              "value": {},
              "required": {
                "type": "boolean"
              },
              "weight": {
                "$ref": "#/$defs/weight"
              }
            }
          }
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetAccountId",
        "organizationId",
        "priority",
        "attributes"
      ],
      "properties": {
        "targetAccountId": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "organizationId": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/attribute"
          }
        }
      }
    },
    "suppressionKind": {
      "enum": [
        "person",
        "organization",
        "domain",
        "source",
        "snapshot",
        "category",
        "crm_state"
      ]
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suppressionId",
        "kind",
        "value",
        "reasonCode",
        "effectiveAt"
      ],
      "properties": {
        "suppressionId": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/suppressionKind"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        },
        "effectiveAt": {
          "$ref": "../common.schema.json#/$defs/dateTime"
        },
        "expiresAt": {
          "$ref": "../common.schema.json#/$defs/dateTime"
        }
      }
    }
  }
}
